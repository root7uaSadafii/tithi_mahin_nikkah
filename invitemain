<script>
/* ===== Config: replace placeholders here ===== */
const CONFIG={
  whatsapp:"8801XXXXXXXXX",           // family's WhatsApp number, digits only with country code
  whatsappShow:"+880 1XXX-XXXXXX",
  eventUTC:Date.UTC(2027,0,9,7,0,0),  // 1:00 PM Dhaka (UTC+6)
  endUTC:Date.UTC(2027,0,9,11,0,0)
};
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const $=s=>document.querySelector(s);
const rand=(a,b)=>a+Math.random()*(b-a);

/* ===== Fairy lights ===== */
const NS='http://www.w3.org/2000/svg';
function drape(svg){
  const W=svg.getBoundingClientRect().width||400,sag=+svg.dataset.sag,n=+svg.dataset.count;
  if(!W)return;
  svg.setAttribute('viewBox',`0 0 ${W} ${sag+34}`);svg.innerHTML='';
  const loops=W<480?2:3,seg=W/loops;let d='M0 4';
  for(let l=0;l<loops;l++)d+=` Q${seg*l+seg/2} ${sag*2-4} ${seg*(l+1)} 4`;
  const p=document.createElementNS(NS,'path');p.setAttribute('d',d);svg.appendChild(p);
  const len=p.getTotalLength(),tot=n*loops/2|0;
  for(let i=1;i<=tot;i++){
    const pt=p.getPointAtLength(len*i/(tot+1));
    const w=document.createElementNS(NS,'line');
    w.setAttribute('x1',pt.x);w.setAttribute('y1',pt.y);w.setAttribute('x2',pt.x);w.setAttribute('y2',pt.y+6);svg.appendChild(w);
    const b=document.createElementNS(NS,'ellipse');
    b.setAttribute('cx',pt.x);b.setAttribute('cy',pt.y+10.5);b.setAttribute('rx',3.4);b.setAttribute('ry',4.8);
    b.setAttribute('class','bulb '+(i%4===0?'rose':'warm'));
    b.style.setProperty('--delay',rand(0,2.6).toFixed(2)+'s');b.style.setProperty('--dur',rand(1.8,3.6).toFixed(2)+'s');
    b.addEventListener('click',()=>{b.classList.remove('flare');void b.getBBox();b.classList.add('flare');chime(rand(0,1)>.5?84:88)});
    b.addEventListener('animationend',e=>{if(e.animationName==='flare')b.classList.remove('flare')});
    svg.appendChild(b);
  }
}
const drapeAll=()=>document.querySelectorAll('svg.lights').forEach(drape);
drapeAll();addEventListener('load',drapeAll);
document.fonts&&document.fonts.ready.then(drapeAll);

/* ===== Local time + clocks ===== */
const userTZ=Intl.DateTimeFormat().resolvedOptions().timeZone||'';
const inDhaka=/Dhaka/.test(userTZ);
(function(){
  const d=new Date(CONFIG.eventUTC);
  const lt=$('#localtime');
  if(inDhaka){lt.textContent='Dhaka time.';return}
  const when=d.toLocaleString(undefined,{weekday:'long',month:'long',day:'numeric',hour:'numeric',minute:'2-digit'});
  const city=(userTZ.split('/').pop()||'your city').replace(/_/g,' ');
  lt.innerHTML='Dhaka time. In '+city+' that’s <b></b>.';
  lt.querySelector('b').textContent=when;
  $('#clk-you-l').textContent='Now in '+city;
})();
const fmtD=new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit',second:'2-digit',timeZone:'Asia/Dhaka'});
const fmtY=new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit',second:'2-digit'});
const pad=n=>String(n).padStart(2,'0');
const last={};
function tick(){
  const s=Math.max(0,Math.floor((CONFIG.eventUTC-Date.now())/1000));
  const v={d:Math.floor(s/86400),h:Math.floor(s%86400/3600),m:Math.floor(s%3600/60),s:s%60};
  for(const k in v){const el=$('#cd-'+k),t=k==='d'?String(v[k]):pad(v[k]);if(last[k]!==t){el.textContent=t;if(last[k]!==undefined&&!reduce){el.classList.remove('tick');void el.offsetWidth;el.classList.add('tick')}last[k]=t}}
  const now=new Date();$('#clk-dhaka').textContent=fmtD.format(now);
  if(inDhaka){$('#clk-you').parentElement.hidden=true}else $('#clk-you').textContent=fmtY.format(now);
}
tick();setInterval(tick,1000);
const z=t=>new Date(t).toISOString().replace(/[-:]/g,'').replace(/\.\d+/,'');
$('#calBtn').href='https://calendar.google.com/calendar/render?action=TEMPLATE&text='+encodeURIComponent('Nikkah of Sadia Tithi & Faiad Rehman')+
  '&dates='+z(CONFIG.eventUTC)+'/'+z(CONFIG.endUTC)+'&location='+encodeURIComponent('Senaprangan Lawn, Dhaka Cantonment, Dhaka')+
  '&details='+encodeURIComponent('We joyfully invite you to celebrate the Nikkah of Sadia Tithi and Faiad Rehman.');

/* ===== Names: hearts ===== */
$('#names').addEventListener('click',e=>{
  const r=e.currentTarget.getBoundingClientRect();
  const x=e.clientX||r.left+r.width/2,y=e.clientY||r.top+r.height/2;
  for(let i=0;i<12;i++){
    const h=document.createElement('span');h.className='heart';h.textContent=['♥','❀','♥','✿'][i%4];
    h.style.left=(x+rand(-30,30))+'px';h.style.top=(y+rand(-10,10))+'px';
    h.style.setProperty('--dx',rand(-80,80)+'px');h.style.setProperty('--rot',rand(-40,40)+'deg');
    h.style.color=['#D99AA0','#8EA184','#E8B9A0','#C9A75F'][i%4];h.style.fontSize=rand(14,24)+'px';
    document.body.appendChild(h);setTimeout(()=>h.remove(),1700);
  }
  chime(81);setTimeout(()=>chime(85),120);setTimeout(()=>chime(88),240);
});

/* ===== Dress code ===== */
const DRESS={
  w:{groups:[
      {label:'Suggested colours',items:[['Soft Sage','#AEBB9E'],['Blush Pink','#EFC9C8'],['Soft Peach','#F3C9A9'],['Butter Yellow','#F4E3A1']]},
      {label:'Kindly avoid',avoid:true,items:[['White','#FBFAF6'],['Ivory','#F4EBD6'],['Red','#B3333A'],['Blue','#2F55A0'],['Dark colours','#2C2B30']]}
    ],
    styles:['Sharara / Gharara','Light Anarkali','Saree','Any elegant desi wear'],
    avoid:'White and ivory are for the bride. Please also avoid red, blue, dark colours and very heavy or overly embellished outfits.'},
  m:{groups:[
      {label:'Punjabi',target:'mPunjabi',items:[['White','#FBFAF6'],['Off-White','#F3EEE4']]},
      {label:'Koti',target:'mKoti',items:[['White','#FFFFFF'],['Cream','#EFE3C6'],['Beige','#D9C6A6']]},
      {label:'Kindly avoid',avoid:true,target:'mPunjabi',items:[['Red','#B3333A'],['Blue','#2F55A0'],['Dark colours','#2C2B30']]}
    ],
    styles:['White Punjabi with a white, cream or beige koti','Something else? Keep it white or off-white'],
    avoid:'Kindly avoid red, blue, dark colours and very heavy or overly embellished outfits.'}
};
let gender='w';const menSel={mPunjabi:'#FBFAF6',mKoti:'#D9C6A6'};
function paint(id,c){const el=document.getElementById(id);if(el)el.setAttribute('fill',c)}
function setVerdict(ok,name){const v=$('#verdict');v.textContent=ok?name+' · Perfect':name+' · Kindly avoid';v.classList.toggle('no',!ok);
  if(!ok&&!reduce){const f=$('#figure');f.classList.remove('shake');void f.offsetWidth;f.classList.add('shake')}}
function renderDress(){
  const D=DRESS[gender];$('#figW').hidden=gender!=='w';$('#figM').hidden=gender!=='m';
  const box=$('#swatchGroups');box.innerHTML='';
  D.groups.forEach((g,gi)=>{
    const wrap=document.createElement('div');
    const lab=document.createElement('p');lab.className='sw-label';lab.textContent=g.label;wrap.appendChild(lab);
    const row=document.createElement('div');row.className='swatches';
    g.items.forEach(([name,c],i)=>{
      const b=document.createElement('button');b.type='button';b.className='sw'+(g.avoid?' avoid':'');b.style.background=c;
      b.setAttribute('aria-label',name+(g.avoid?' (avoid)':''));b.setAttribute('aria-pressed','false');b.title=name;
      b.addEventListener('click',()=>{
        const all=[...box.querySelectorAll('.sw')],off=s=>s.setAttribute('aria-pressed','false');
        if(gender==='w'){paint('wTop',c);paint('wSkirt',c);paint('wDupatta',shade(c,-8));all.forEach(off)}
        else if(g.avoid){paint('mPunjabi',c);paint('mKoti',shade(c,-12));all.forEach(off)}
        else{menSel[g.target]=c;paint('mPunjabi',menSel.mPunjabi);paint('mKoti',menSel.mKoti);row.querySelectorAll('.sw').forEach(off);all.filter(s=>s.dataset.avoid).forEach(off)}
        b.setAttribute('aria-pressed','true');setVerdict(!g.avoid,name);chime(g.avoid?62:79);
      });
      b.dataset.g=gi;if(g.avoid)b.dataset.avoid=1;
      row.appendChild(b);
    });
    wrap.appendChild(row);box.appendChild(wrap);
  });
  $('#styles').innerHTML='';D.styles.forEach(s=>{const c=document.createElement('span');c.className='chip';c.textContent=s;$('#styles').appendChild(c)});
  $('#avoidbox').innerHTML='<b>KINDLY AVOID</b>';$('#avoidbox').append(D.avoid);
  if(gender==='w'){paint('wTop','#AEBB9E');paint('wSkirt','#AEBB9E');paint('wDupatta',shade('#AEBB9E',-8));setVerdict(true,'Soft Sage');box.querySelector('.sw').setAttribute('aria-pressed','true')}
  else{menSel.mPunjabi='#FBFAF6';menSel.mKoti='#D9C6A6';paint('mPunjabi','#FBFAF6');paint('mKoti','#D9C6A6');setVerdict(true,'White & Beige');const s=box.querySelectorAll('.sw');s[0].setAttribute('aria-pressed','true');s[4].setAttribute('aria-pressed','true')}
}
function shade(hex,p){const n=parseInt(hex.slice(1),16);let r=n>>16,g=n>>8&255,b=n&255;const f=x=>Math.max(0,Math.min(255,Math.round(x*(1+p/100))));return'#'+[f(r),f(g),f(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}
['w','m'].forEach(g=>$('#tab-'+g).addEventListener('click',()=>{gender=g;$('#tab-w').setAttribute('aria-selected',g==='w');$('#tab-m').setAttribute('aria-selected',g==='m');renderDress()}));
renderDress();

/* ===== Sky: petals + fireflies ===== */
let evening=false;
const sky=$('#sky'),sx=sky.getContext('2d');let SW,SH;
function sizeSky(){const d=devicePixelRatio||1;SW=innerWidth;SH=innerHeight;sky.width=SW*d;sky.height=SH*d;sx.setTransform(d,0,0,d,0,0)}
sizeSky();
const petalCols=['rgba(239,201,200,.85)','rgba(250,246,236,.95)','rgba(174,187,158,.7)','rgba(243,201,169,.75)'];
const petals=Array.from({length:innerWidth<500?16:26},()=>mkPetal(true));
function mkPetal(init){return{x:rand(0,SW),y:init?rand(0,SH):-20,r:rand(4,8),vy:rand(.3,.8),sw:rand(0,6.28),sp:rand(.01,.025),rot:rand(0,6),vr:rand(-.03,.03),c:petalCols[Math.random()*4|0]}}
const flies=Array.from({length:22},()=>({x:rand(0,1),y:rand(.3,1),a:rand(0,6.28),s:rand(.0004,.0012),ph:rand(0,6.28)}));
function skyLoop(t){
  sx.clearRect(0,0,SW,SH);
  for(const p of petals){
    p.y+=p.vy;p.sw+=p.sp;p.x+=Math.sin(p.sw)*.7;p.rot+=p.vr;if(p.y>SH+20)Object.assign(p,mkPetal(false));
    sx.save();sx.translate(p.x,p.y);sx.rotate(p.rot);sx.scale(1,.55+.45*Math.cos(p.sw*2));
    sx.beginPath();sx.moveTo(0,-p.r);sx.quadraticCurveTo(p.r,0,0,p.r);sx.quadraticCurveTo(-p.r,0,0,-p.r);sx.fillStyle=p.c;sx.fill();sx.restore();
  }
  if(evening){for(const f of flies){
    f.a+=rand(-.15,.15);f.x+=Math.cos(f.a)*f.s;f.y+=Math.sin(f.a)*f.s;if(f.x<0||f.x>1)f.a=Math.PI-f.a;if(f.y<.2||f.y>1)f.a=-f.a;
    const al=.35+.65*Math.max(0,Math.sin(t/600+f.ph));
    const g=sx.createRadialGradient(f.x*SW,f.y*SH,0,f.x*SW,f.y*SH,9);g.addColorStop(0,`rgba(255,236,160,${al})`);g.addColorStop(1,'rgba(255,236,160,0)');
    sx.fillStyle=g;sx.beginPath();sx.arc(f.x*SW,f.y*SH,9,0,6.28);sx.fill();
  }}
  requestAnimationFrame(skyLoop);
}
if(!reduce)requestAnimationFrame(skyLoop);

/* ===== Butterflies ===== */
const BCOL=[['#7FA6D6','#4D79B5'],['#F2C4C6','#D99AA0'],['#F4E3A1','#D9BE5E'],['#F3C9A9','#D99B6F'],['#C3D0B6','#8EA184']];
const bflies=[];
function mkBfly(i){
  const [c1,c2]=BCOL[i%BCOL.length];
  const el=document.createElement('button');el.className='bfly';el.setAttribute('aria-hidden','true');el.tabIndex=-1;
  el.innerHTML=`<svg viewBox="0 0 34 28"><g class="wl"><path d="M17 14C11 2 2 1 2 8s7 7 15 6z" fill="${c1}"/><path d="M17 14c-6 1-12 4-10 10 3 4 9-2 10-10z" fill="${c2}"/></g><g class="wr"><path d="M17 14C23 2 32 1 32 8s-7 7-15 6z" fill="${c1}"/><path d="M17 14c6 1 12 4 10 10-3 4-9-2-10-10z" fill="${c2}"/></g><path d="M17 8v15" stroke="#4A4235" stroke-width="1.6" stroke-linecap="round"/></svg>`;
  $('#bflies').appendChild(el);
  const b={el,x:rand(0,innerWidth),y:rand(innerHeight*.3,innerHeight*.9),tx:0,ty:0,vx:0,vy:0,rest:0,flee:0,sc:rand(.75,1.1)};
  pickTarget(b);
  el.addEventListener('click',()=>{b.flee=90;b.rest=0;el.classList.remove('rest');b.tx=b.x+rand(-1,1)*innerWidth;b.ty=-120;chime(91)});
  bflies.push(b);
}
function pickTarget(b){b.tx=rand(20,innerWidth-40);b.ty=rand(innerHeight*.15,innerHeight*.92)}
function bLoop(){
  for(const b of bflies){
    if(b.rest>0){b.rest--;if(b.rest===0)b.el.classList.remove('rest')}
    else{
      const dx=b.tx-b.x,dy=b.ty-b.y,d=Math.hypot(dx,dy);
      const sp=b.flee>0?4.2:1.3;
      b.vx+=(dx/d)*.08*sp+rand(-.25,.25);b.vy+=(dy/d)*.08*sp+rand(-.3,.3)+Math.sin(performance.now()/180+b.sc*9)*.12;
      b.vx*=.94;b.vy*=.94;b.x+=b.vx;b.y+=b.vy;
      if(b.flee>0){b.flee--;if(b.flee===0||b.y<-60){b.x=rand(0,innerWidth);b.y=innerHeight+40;pickTarget(b);b.flee=0}}
      else if(d<24){if(Math.random()<.5){b.rest=rand(90,260)|0;b.el.classList.add('rest')}pickTarget(b)}
    }
    const ang=Math.max(-.5,Math.min(.5,b.vx*.12));
    b.el.style.transform=`translate(${b.x}px,${b.y}px) rotate(${ang}rad) scale(${b.sc})`;
  }
  requestAnimationFrame(bLoop);
}
if(!reduce){for(let i=0;i<(innerWidth<500?4:6);i++)mkBfly(i);requestAnimationFrame(bLoop)}

/* ===== Fountain ===== */
const fc=$('#fountain'),fx=fc.getContext('2d');let FW=0,FH=0;
function sizeF(){const r=fc.getBoundingClientRect(),d=devicePixelRatio||1;FW=r.width;FH=r.height;fc.width=FW*d;fc.height=FH*d;fx.setTransform(d,0,0,d,0,0)}
const drops=[],ripples=[],sparks=[];
// emitters in image fractions
const TIERS=[{y:.335,x0:.455,x1:.548},{y:.44,x0:.43,x1:.572},{y:.575,x0:.395,x1:.612}];
const BASIN={y:.725,x0:.37,x1:.66,cx:.505};
function spawn(){
  // top jet
  drops.push({x:.505+rand(-.004,.004),y:.29,vx:rand(-.0012,.0012),vy:rand(-.006,-.004),floor:TIERS[0].y,life:0});
  // tier drips
  TIERS.forEach((t,i)=>{const side=Math.random()<.5;const x=side?t.x0+rand(0,.012):t.x1-rand(0,.012);
    drops.push({x,y:t.y,vx:(side?-1:1)*rand(0,.0006),vy:rand(0,.001),floor:i<2?TIERS[i+1].y:BASIN.y,life:0})});
}
function fLoop(){
  if(!FW){requestAnimationFrame(fLoop);return}
  fx.clearRect(0,0,FW,FH);
  for(let k=0;k<2;k++)spawn();
  for(let i=drops.length-1;i>=0;i--){const d=drops[i];d.vy+=.00028;d.x+=d.vx;d.y+=d.vy;d.life++;
    if(d.y>=d.floor&&d.vy>0){if(d.floor===BASIN.y&&Math.random()<.08)ripples.push({x:d.x,y:BASIN.y+rand(0,.015),r:0,a:.5});drops.splice(i,1);continue}
    fx.fillStyle='rgba(235,245,250,.75)';fx.beginPath();fx.ellipse(d.x*FW,d.y*FH,1.1,2.2,0,0,6.28);fx.fill()}
  for(let i=ripples.length-1;i>=0;i--){const r=ripples[i];r.r+=.5;r.a-=.008;if(r.a<=0){ripples.splice(i,1);continue}
    fx.strokeStyle=`rgba(240,248,250,${r.a})`;fx.lineWidth=1;fx.beginPath();fx.ellipse(r.x*FW,r.y*FH,r.r,r.r*.32,0,0,6.28);fx.stroke()}
  for(let i=sparks.length-1;i>=0;i--){const s=sparks[i];s.x+=s.vx;s.y+=s.vy;s.vy+=.03;s.a-=.015;if(s.a<=0){sparks.splice(i,1);continue}
    fx.fillStyle=`rgba(255,226,150,${s.a})`;fx.beginPath();fx.arc(s.x,s.y,s.r,0,6.28);fx.fill()}
  requestAnimationFrame(fLoop);
}
const gImg=$('#gardenImg');
const startF=()=>{sizeF();if(!reduce&&!startF.on){startF.on=1;requestAnimationFrame(fLoop)}};
gImg.complete?startF():gImg.addEventListener('load',startF);
fc.addEventListener('click',e=>{const r=fc.getBoundingClientRect();burst(e.clientX-r.left,e.clientY-r.top);chime(86)});
function burst(x,y,n=18){for(let i=0;i<n;i++)sparks.push({x,y,vx:rand(-2,2),vy:rand(-3,-.5),r:rand(1,2.6),a:1})}

/* ===== Wishing fountain ===== */
$('#wishForm').addEventListener('submit',e=>{
  e.preventDefault();
  const txt=$('#wishText').value.trim()||'May your home be filled with barakah and love.';
  const btn=e.submitter||$('#wishForm button');const br=btn.getBoundingClientRect();
  const fr=fc.getBoundingClientRect();
  const tx=fr.left+BASIN.cx*fr.width,ty=fr.top+BASIN.y*fr.height;
  const coin=document.createElement('div');coin.className='coin';document.body.appendChild(coin);
  const sx0=br.left+br.width/2,sy0=br.top;
  const t0=performance.now(),dur=reduce?10:900;
  (function fly(now){const p=Math.min(1,(now-t0)/dur);const x=sx0+(tx-sx0)*p,y=sy0+(ty-sy0)*p-Math.sin(p*Math.PI)*180;
    coin.style.transform=`translate(${x-8}px,${y-8}px) rotate(${p*720}deg)`;
    if(p<1)requestAnimationFrame(fly);else{coin.remove();
      for(let i=0;i<3;i++)ripples.push({x:BASIN.cx+rand(-.01,.01),y:BASIN.y+.01,r:i*6,a:.8});
      burst(BASIN.cx*fr.width,BASIN.y*fr.height,30);chime(79);setTimeout(()=>chime(83),150);setTimeout(()=>chime(86),300);
      const l=document.createElement('div');l.className='lantern';l.textContent=txt;
      l.style.left=tx+'px';l.style.top=(ty-40)+'px';l.style.setProperty('--drift',rand(-60,60)+'px');
      document.body.appendChild(l);setTimeout(()=>l.remove(),6100);
    }})(t0);
  $('#wishSend').href='https://wa.me/'+CONFIG.whatsapp+'?text='+encodeURIComponent('A dua for Sadia & Faiad: '+txt);
  $('#wishSendRow').hidden=false;$('#wishNote').textContent='Your wish is on its way up. Toss another any time.';
  $('#wishText').value='';
});

/* ===== RSVP ===== */
let guests=1;
function rsvpText(){
  const n=$('#rName').value.trim()||'[Your name]';const yes=$('#attY').checked;const msg=$('#rMsg').value.trim();
  let t=yes?`Assalamu Alaikum! This is ${n}. I'm joyfully attending the Nikkah of Sadia & Faiad on 9 January 2027, with ${guests} ${guests===1?'guest':'guests'} in total.`
           :`Assalamu Alaikum! This is ${n}. Sadly I can't attend the Nikkah of Sadia & Faiad on 9 January 2027, but I'm sending my duas from afar.`;
  if(msg)t+=`\n\n${msg}`;return t;
}
function upd(){$('#gCount').textContent=guests;$('#countWrap').style.display=$('#attY').checked?'grid':'none';const t=rsvpText();$('#rPreview').textContent=t;$('#waLink').href='https://wa.me/'+CONFIG.whatsapp+'?text='+encodeURIComponent(t)}
['rName','rMsg'].forEach(id=>$('#'+id).addEventListener('input',upd));
['attY','attN'].forEach(id=>$('#'+id).addEventListener('change',upd));
$('#minus').addEventListener('click',()=>{guests=Math.max(1,guests-1);upd()});
$('#plus').addEventListener('click',()=>{guests=Math.min(10,guests+1);upd()});
upd();$('#waShow').textContent=CONFIG.whatsappShow;
$('#rsvp').addEventListener('submit',e=>e.preventDefault());
$('#waLink').addEventListener('click',()=>{
  $('#rsvpNote').textContent='WhatsApp should open with your message ready. If it didn’t, copy the message above and send it to '+CONFIG.whatsappShow+'.';
});
$('#copyBtn').addEventListener('click',()=>{
  const t=rsvpText(),b=$('#copyBtn');
  const done=()=>{b.textContent='Copied';setTimeout(()=>b.textContent='Copy message',1800)};
  try{navigator.clipboard.writeText(t).then(done,()=>{selectPrev();b.textContent='Selected, press copy'})}catch(_){selectPrev()}
});
function selectPrev(){const r=document.createRange();r.selectNodeContents($('#rPreview'));const s=getSelection();s.removeAllRanges();s.addRange(r)}

/* ===== Evening ===== */
$('#eveBtn').addEventListener('click',()=>{evening=!evening;document.body.classList.toggle('evening',evening);
  const b=$('#eveBtn');b.classList.toggle('on',evening);b.setAttribute('aria-pressed',evening);b.setAttribute('aria-label',evening?'Switch to daytime garden':'Switch to evening garden')});

/* ===== Music: original music-box tune, synthesized (swap for an MP3 later) ===== */
let actx,master;
function audio(){if(!actx){actx=new (window.AudioContext||window.webkitAudioContext)();master=actx.createGain();master.gain.value=0;
  const lp=actx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=3400;const dl=actx.createDelay();dl.delayTime.value=.42;const fb=actx.createGain();fb.gain.value=.3;const wet=actx.createGain();wet.gain.value=.3;
  master.connect(lp);lp.connect(actx.destination);master.connect(dl);dl.connect(fb);fb.connect(dl);dl.connect(wet);wet.connect(lp);
  fxGain=actx.createGain();fxGain.gain.value=.5;fxGain.connect(lp)}return actx}
let fxGain;
const mf=n=>440*Math.pow(2,(n-69)/12);
function tone(n,t,v,len,dest){[[1,'sine',v],[2,'sine',v*.22],[3.01,'triangle',v*.06]].forEach(([m,tp,vv])=>{const o=actx.createOscillator(),g=actx.createGain();o.type=tp;o.frequency.value=mf(n)*m;
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vv,t+.01);g.gain.exponentialRampToValueAtTime(.0001,t+len);o.connect(g);g.connect(dest);o.start(t);o.stop(t+len+.05)})}
function chime(n){try{if(!playing||!actx||actx.state!=='running')return;tone(n,actx.currentTime,.12,1.2,fxGain)}catch(_){}}
// G major lullaby, 8th-note grid
const MEL=[79,null,83,86,84,83,81,null, 79,81,83,null,81,79,76,null, 74,76,79,81,83,null,86,84, 83,81,79,null,null,null,null,null,
           76,79,81,83,84,null,83,81, 79,81,83,86,88,null,86,null, 84,83,81,79,81,83,81,null, 79,null,null,null,null,null,null,null];
const BAS=[55,null,null,null,62,null,null,null, 52,null,null,null,59,null,null,null, 48,null,null,null,55,null,null,null, 50,null,null,null,57,null,null,null,
           52,null,null,null,59,null,null,null, 48,null,null,null,55,null,null,null, 50,null,null,null,54,null,null,null, 55,null,null,null,62,null,null,null];
let playing=false,timer=null,step=0,nextT=0;const BEAT=.38;
function sched(){while(nextT<actx.currentTime+.4){const i=step%MEL.length;if(MEL[i])tone(MEL[i],nextT,.2,1.9,master);if(BAS[i])tone(BAS[i],nextT,.14,2.8,master);nextT+=BEAT;step++}}
function playMusic(){audio();actx.resume();master.gain.cancelScheduledValues(actx.currentTime);master.gain.setValueAtTime(master.gain.value,actx.currentTime);master.gain.linearRampToValueAtTime(.8,actx.currentTime+1.5);
  if(!timer){nextT=actx.currentTime+.1;timer=setInterval(sched,100)}playing=true;syncM()}
function pauseMusic(){if(!actx)return;master.gain.cancelScheduledValues(actx.currentTime);master.gain.setValueAtTime(master.gain.value,actx.currentTime);master.gain.linearRampToValueAtTime(0,actx.currentTime+.6);
  playing=false;setTimeout(()=>{if(!playing&&timer){clearInterval(timer);timer=null}},700);syncM()}
function syncM(){const b=$('#musicBtn');b.classList.toggle('on',playing);b.setAttribute('aria-pressed',playing);b.setAttribute('aria-label',playing?'Pause music':'Play music')}
$('#musicBtn').addEventListener('click',()=>playing?pauseMusic():playMusic());

/* ===== Envelope ===== */
const intro=$('#intro'),env=$('#env'),names=$('#names');
document.documentElement.style.overflow='hidden';
env.addEventListener('click',()=>{
  if(env.classList.contains('open'))return;
  env.classList.add('open');
  try{playMusic()}catch(_){}
  setTimeout(()=>{intro.classList.add('gone');document.documentElement.style.overflow='';names.classList.add('revealed');setTimeout(drapeAll,50)},1500);
  setTimeout(()=>{intro.hidden=true},2700);
  setTimeout(()=>{names.classList.remove('armed','revealed')},5000);
});
addEventListener('resize',()=>{clearTimeout(window.__rt);window.__rt=setTimeout(()=>{drapeAll();sizeSky();sizeF()},150)});
</script>

