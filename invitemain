<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="You are joyfully invited to the Nikkah of Sadia Tithi and Faiad Rehman, Saturday 9 January 2027, Senaprangan Lawn, Dhaka.">
<meta property="og:title" content="Nikkah of Sadia Tithi &amp; Faiad Rehman">
<meta property="og:description" content="Saturday 9 January 2027 · 1:00 PM · Senaprangan Lawn, Dhaka">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
</head>
<body>
<title>Sadia &amp; Faiad Nikkah</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Great+Vibes&family=Hind+Siliguri:wght@400;500&family=Cinzel:wght@400;500&display=swap">
<style>
/* Layout: one tall stationery column on her paper tone; her florals crown the top, her garden closes the scroll; interaction lives in quiet framed panels between. Deliberately single light theme (printed card), with an in-page Evening toggle. */
:root{
  --paper:#F3EDE0;
  --paper-2:#EAE2D0;
  --card:#FAF6EC;
  --sage-deep:#3F5A36;
  --sage:#6F8A63;
  --sage-soft:#B9C7AE;
  --blush:#EDCFCB;
  --gold:#B49B6C;
  --ink:#46402F;
  --muted:#857C68;
  --night:#2B3327;
  --glow:#FFE3A3;
  --f-script:"Great Vibes","Snell Roundhand","Apple Chancery",cursive;
  --f-serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;
  --f-caps:"Cinzel","Trajan Pro",Georgia,serif;
  --f-arabic:"Amiri","Traditional Arabic",serif;
  --f-bn:"Hind Siliguri","Noto Sans Bengali",sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--f-serif);font-size:19px;line-height:1.55;overflow-x:hidden;
  background-image:radial-gradient(ellipse at 15% 5%,rgba(255,255,255,.55),transparent 45%),radial-gradient(ellipse at 90% 40%,rgba(185,199,174,.18),transparent 50%),radial-gradient(ellipse at 10% 75%,rgba(237,207,203,.22),transparent 45%);
  transition:background-color 1.2s ease}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:4;background:linear-gradient(180deg,rgba(28,36,30,.0),rgba(28,36,30,.0));transition:background 1.4s ease}
body.evening::after{background:linear-gradient(180deg,rgba(26,32,40,.42),rgba(43,51,39,.3) 60%,rgba(43,51,39,.22))}
.wrap{max-width:620px;margin:0 auto;position:relative;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 0}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--sage-deep);outline-offset:3px;border-radius:4px}

/* ---------- Hero ---------- */
.hero{position:relative;text-align:center;padding-block:120px 34px;display:flex;flex-direction:column;align-items:center;gap:14px}
.floral{position:absolute;pointer-events:none;z-index:0;transform-origin:top center;animation:sway 7s ease-in-out infinite}
.floral.tl{left:calc(-1*max(16px,env(safe-area-inset-left,0px)));top:0;width:min(40%,250px)}
.floral.tr{right:calc(-1*max(16px,env(safe-area-inset-right,0px)));top:0;width:min(40%,220px);animation-delay:-3s;transform-origin:top right}
@keyframes sway{0%,100%{transform:rotate(0)}50%{transform:rotate(1.6deg)}}
.hero > *:not(.floral):not(.lights){position:relative;z-index:1}
.lights{position:absolute;left:calc(-1*max(16px,env(safe-area-inset-left,0px)));right:calc(-1*max(16px,env(safe-area-inset-right,0px)));top:0;height:96px;width:calc(100% + 2*max(16px,env(safe-area-inset-left,0px)));overflow:visible;z-index:2}
svg.lights path{fill:none;stroke:#9E8F72;stroke-width:1}
svg.lights line{stroke:#9E8F72}
.bulb{cursor:pointer;pointer-events:all;animation:twinkle var(--dur,2.6s) ease-in-out var(--delay,0s) infinite;transform-box:fill-box;transform-origin:center}
.bulb.warm{fill:var(--glow);filter:drop-shadow(0 0 3px #FFD887) drop-shadow(0 0 8px #FFE3A3)}
.bulb.rose{fill:#F6CFD0;filter:drop-shadow(0 0 3px #F3B9BC) drop-shadow(0 0 8px #F6CFD0)}
.bulb.flare{animation:flare .9s ease-out}
@keyframes twinkle{0%,100%{opacity:1}40%{opacity:.28}60%{opacity:.95}}
@keyframes flare{0%{transform:scale(1)}30%{transform:scale(2.2);opacity:1}100%{transform:scale(1)}}
body.evening .bulb.warm{filter:drop-shadow(0 0 5px #FFD887) drop-shadow(0 0 16px #FFD887)}
body.evening .bulb.rose{filter:drop-shadow(0 0 5px #F3B9BC) drop-shadow(0 0 16px #F3B9BC)}
body.evening .lights, body.evening .fixed-ui{z-index:6}

.bismillah{font-family:var(--f-arabic);color:var(--sage);font-size:1.5rem;margin:0;line-height:1.5}
.bn-title{font-family:var(--f-bn);color:var(--gold);letter-spacing:.06em;margin:0;font-size:1rem}
.invite-line{margin:6px 0 0;font-size:1.3rem;line-height:1.3;color:var(--ink);max-width:22ch;text-wrap:balance}
.names{margin:0;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;user-select:none;-webkit-tap-highlight-color:transparent;background:none;border:0;padding:0}
.name{font-family:var(--f-script);font-weight:400;color:var(--sage-deep);font-size:clamp(3.1rem,13.5vw,4.6rem);line-height:1.15;display:block;padding:0 .2em;
  clip-path:inset(0 0 0 0)}
.armed .name{clip-path:inset(0 100% 0 0)}
.revealed .name{animation:write 1.9s cubic-bezier(.55,.1,.35,1) forwards}
.revealed .name.n2{animation-delay:1.25s}
@keyframes write{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
.and{font-family:var(--f-serif);font-size:1.35rem;color:var(--ink);letter-spacing:.04em}
.journey{margin:0;font-size:1.15rem;color:var(--ink)}
.tap-hint{font-family:var(--f-caps);font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin:0}
.ornament{width:min(340px,80%);height:22px;color:var(--gold);margin-block:8px}
.heart{position:fixed;pointer-events:none;z-index:30;font-size:18px;color:#D99AA0;animation:float-up 1.6s ease-out forwards}
@keyframes float-up{to{transform:translate(var(--dx),-140px) scale(.6) rotate(var(--rot));opacity:0}}

/* ---------- Date ---------- */
.datecard{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;width:100%;max-width:440px;margin-inline:auto}
.datecard .side{font-family:var(--f-caps);font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;border-block:1px solid var(--gold);padding-block:9px;color:var(--ink)}
.datecard .big{font-family:var(--f-serif);font-style:italic;font-size:4.2rem;line-height:.95;color:var(--sage-deep)}
.datecard .big sup{font-size:.35em;vertical-align:super}
.datecard .mon{display:block;font-family:var(--f-caps);font-style:normal;font-size:.72rem;letter-spacing:.3em;color:var(--muted);margin-top:4px}
.venue-line{font-style:italic;font-size:1.35rem;margin:6px 0 0;color:var(--ink)}
.localtime{font-size:1rem;color:var(--muted);margin:0;max-width:34ch;text-wrap:balance}
.localtime b{color:var(--sage-deep);font-weight:600}

/* ---------- Sections ---------- */
section.panel{position:relative;z-index:1;margin-block:26px;padding:30px 22px;background:var(--card);border:1px solid var(--paper-2);border-radius:3px;box-shadow:0 18px 40px -32px rgba(63,90,54,.5)}
section.panel::before{content:"";position:absolute;inset:7px;border:1px solid rgba(180,155,108,.35);pointer-events:none}
.panel h2{font-family:var(--f-caps);font-weight:400;font-size:1.05rem;letter-spacing:.28em;text-transform:uppercase;color:var(--sage-deep);text-align:center;margin:0}
.panel .sub{text-align:center;font-style:italic;color:var(--muted);margin:6px auto 20px;max-width:36ch;text-wrap:balance}
.rule{display:flex;align-items:center;gap:10px;color:var(--gold);justify-content:center;margin:8px 0 4px}
.rule::before,.rule::after{content:"";height:1px;width:56px;background:currentColor;opacity:.6}
.rule span{font-size:.7rem}
.btn{font-family:var(--f-caps);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;
  border:1px solid var(--sage);background:transparent;color:var(--sage-deep);padding:12px 18px;border-radius:999px;transition:background .25s,color .25s,transform .15s}
.btn:hover{background:var(--sage-deep);color:var(--card);border-color:var(--sage-deep)}
.btn:active{transform:scale(.97)}
.btn.solid{background:var(--sage-deep);color:var(--card);border-color:var(--sage-deep)}
.btn.solid:hover{background:var(--sage)}
.row{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
.ph{border-bottom:1px dashed var(--gold);color:inherit}

/* Countdown */
.count{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:4px}
.unit{background:var(--paper);border:1px solid var(--paper-2);border-radius:3px;padding:12px 4px 10px;text-align:center;overflow:hidden}
.unit b{display:block;font-family:var(--f-serif);font-weight:500;font-size:2.2rem;line-height:1.05;color:var(--sage-deep);font-variant-numeric:tabular-nums lining-nums}
.unit b.tick{animation:tick .45s ease}
@keyframes tick{0%{transform:translateY(-40%);opacity:0}100%{transform:none;opacity:1}}
.unit span{font-family:var(--f-caps);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.clocks{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.clock{border-top:1px solid var(--paper-2);padding-top:10px;text-align:center;min-width:0}
.clock small{display:block;font-family:var(--f-caps);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.clock span{font-size:1.25rem;color:var(--ink);font-variant-numeric:tabular-nums}

/* Programme */
.timeline{list-style:none;margin:0;padding:0;position:relative}
.timeline::before{content:"";position:absolute;left:68px;top:12px;bottom:12px;width:1px;background:var(--sage-soft)}
.timeline li{position:relative}
.timeline details{padding:6px 0}
.timeline summary{list-style:none;display:grid;grid-template-columns:56px 24px 1fr;align-items:center;gap:0;cursor:pointer;padding:6px 0}
.timeline summary::-webkit-details-marker{display:none}
.timeline .t{font-variant-numeric:tabular-nums;font-size:.95rem;color:var(--muted);text-align:right;padding-right:6px}
.timeline .dot{width:11px;height:11px;border-radius:50%;background:var(--card);border:1.5px solid var(--sage);justify-self:center;transition:background .3s,transform .3s}
.timeline details[open] .dot{background:var(--sage);transform:scale(1.25)}
.timeline .what{font-size:1.2rem;color:var(--ink);padding-left:10px;display:flex;justify-content:space-between;gap:8px;align-items:center}
.timeline .what::after{content:"+";font-family:var(--f-caps);color:var(--gold);font-size:1rem;transition:transform .3s}
.timeline details[open] .what::after{transform:rotate(45deg)}
.timeline p{margin:2px 0 8px 90px;color:var(--muted);font-size:1.02rem;font-style:italic}

/* Dress code */
.tabs{display:flex;justify-content:center;gap:6px;margin-bottom:18px}
.tab{font-family:var(--f-caps);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;padding:10px 16px;border:1px solid var(--paper-2);background:var(--paper);border-radius:999px;cursor:pointer;color:var(--muted)}
.tab[aria-selected="true"]{background:var(--sage-deep);color:var(--card);border-color:var(--sage-deep)}
.dress{display:grid;grid-template-columns:150px 1fr;gap:18px;align-items:center}
.figure{position:relative;width:150px;height:230px;max-width:100%}
.figure svg{width:100%;height:100%;overflow:visible}
.figure .fill{transition:fill .6s ease}
.figure.shake{animation:shake .5s ease}
@keyframes shake{20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}
.verdict{position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);white-space:nowrap;font-family:var(--f-caps);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;padding:5px 10px;border-radius:999px;background:var(--sage-deep);color:var(--card);transition:background .3s}
.verdict.no{background:#9A5B57}
.swatch-groups{display:flex;flex-direction:column;gap:12px;min-width:0}
.sw-label{font-family:var(--f-caps);font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin:0 0 6px}
.swatches{display:flex;flex-wrap:wrap;gap:10px}
.sw{width:42px;height:42px;border-radius:50%;border:1px solid rgba(70,64,47,.18);cursor:pointer;position:relative;padding:0;transition:transform .2s;box-shadow:inset 0 -4px 8px rgba(0,0,0,.06)}
.sw:hover{transform:scale(1.08)}
.sw[aria-pressed="true"]{outline:2px solid var(--sage-deep);outline-offset:3px}
.sw.avoid::after{content:"";position:absolute;left:50%;top:6px;bottom:6px;width:1.5px;background:var(--card);transform:rotate(45deg);opacity:.9}
.sw-name{font-size:1.05rem;color:var(--ink);margin:4px 0 0;min-height:1.6em}
.styles{margin:18px 0 0;text-align:center;color:var(--ink);font-size:1.08rem}
.styles .chip{display:inline-block;border:1px solid var(--paper-2);background:var(--paper);border-radius:999px;padding:3px 12px;margin:3px;font-size:1rem}
.avoidbox{margin-top:16px;background:#F5E6E2;border-radius:3px;padding:12px 14px;text-align:center;color:#7E4C48;font-size:1.02rem}
.avoidbox b{font-family:var(--f-caps);font-weight:400;font-size:.66rem;letter-spacing:.22em;display:block;margin-bottom:2px}

/* Garden + fountain */
.garden{position:relative;margin-inline:calc(-1*max(16px,env(safe-area-inset-left,0px)));margin-top:10px;z-index:1}
.garden img{display:block;width:100%;height:auto;max-width:100%}
.garden canvas{position:absolute;inset:0;width:100%;height:100%;cursor:pointer}
.wish{position:relative;z-index:2;margin-top:-30px}
.wish form{display:flex;gap:8px;flex-wrap:wrap}
.wish input{flex:1 1 220px;min-width:0}
.lantern{position:fixed;z-index:25;pointer-events:none;max-width:220px;text-align:center;font-style:italic;color:var(--sage-deep);background:rgba(250,246,236,.92);border:1px solid var(--gold);border-radius:14px 14px 20px 20px;padding:10px 14px;font-size:1rem;box-shadow:0 0 24px rgba(255,227,163,.8);
  animation:rise 6s ease-in forwards}
@keyframes rise{0%{transform:translate(-50%,0) scale(.6);opacity:0}12%{opacity:1;transform:translate(-50%,-30px) scale(1)}100%{transform:translate(calc(-50% + var(--drift)),-75vh) scale(.7);opacity:0}}
.coin{position:fixed;z-index:26;width:16px;height:16px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#FFF3C4,#D4B162 60%,#A8853C);pointer-events:none}

/* Forms */
label.f{display:grid;gap:6px;font-family:var(--f-caps);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
input[type=text],textarea{font-family:var(--f-serif);font-size:1.1rem;color:var(--ink);background:var(--paper);border:1px solid var(--paper-2);border-radius:3px;padding:11px 13px;width:100%;letter-spacing:0;text-transform:none}
textarea{min-height:76px;resize:vertical}
input::placeholder,textarea::placeholder{color:#A69E8A;font-style:italic}
.rsvp{display:grid;gap:16px}
.choice{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.choice input{position:absolute;opacity:0;pointer-events:none}
.choice label{border:1px solid var(--paper-2);background:var(--paper);border-radius:3px;padding:14px 10px;text-align:center;cursor:pointer;font-size:1.08rem;transition:all .25s}
.choice input:checked + label{background:var(--sage-deep);color:var(--card);border-color:var(--sage-deep)}
.choice input:focus-visible + label{outline:2px solid var(--sage-deep);outline-offset:2px}
.stepper{display:flex;align-items:center;gap:14px}
.stepper button{width:40px;height:40px;border-radius:50%;border:1px solid var(--sage);background:transparent;cursor:pointer;font-size:1.2rem;color:var(--sage-deep)}
.stepper output{font-size:1.6rem;min-width:2ch;text-align:center;font-variant-numeric:tabular-nums;color:var(--sage-deep)}
.preview{background:var(--paper);border:1px dashed var(--gold);border-radius:3px;padding:12px 14px;font-size:1rem;white-space:pre-wrap;user-select:all;color:var(--ink);min-width:0;overflow-wrap:anywhere}
.note{font-size:.95rem;color:var(--muted);font-style:italic;margin:0;text-align:center}

/* Venue */
.venue-art{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
.venue-art h3{font-family:var(--f-serif);font-style:italic;font-weight:500;font-size:1.8rem;color:var(--sage-deep);margin:0}
.venue-art p{margin:0}

/* Envelope intro */
.intro{position:fixed;inset:0;z-index:40;display:grid;place-items:center;background:var(--paper);transition:opacity 1s ease, visibility 0s linear 1s;
  padding:env(safe-area-inset-top,0px) max(16px,env(safe-area-inset-right,0px)) env(safe-area-inset-bottom,0px) max(16px,env(safe-area-inset-left,0px));
  background-image:radial-gradient(ellipse at 50% 40%,rgba(255,255,255,.7),transparent 60%)}
.intro.gone{opacity:0;visibility:hidden}
.intro .lights{left:0;right:0;width:100%;top:env(safe-area-inset-top,0px)}
.intro-inner{display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center}
.intro .to{font-family:var(--f-caps);font-size:.68rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);margin:0}
.intro .initials{font-family:var(--f-script);font-size:2.6rem;color:var(--sage-deep);margin:0;line-height:1}
.env{position:relative;width:min(330px,86vw);aspect-ratio:3/2;border:0;padding:0;background:none;cursor:pointer;perspective:1000px;max-width:100%}
.env .back{position:absolute;inset:0;background:#8EA184;border-radius:4px;box-shadow:0 30px 50px -28px rgba(63,90,54,.7)}
.env .letter{position:absolute;left:6%;right:6%;top:8%;bottom:6%;background:var(--card);border-radius:2px;transition:transform 1s cubic-bezier(.3,.8,.3,1) .45s;display:grid;place-items:center;
  font-family:var(--f-script);color:var(--sage-deep);font-size:1.7rem}
.env .front{position:absolute;inset:0;background:#9DAF92;clip-path:polygon(0 0,50% 55%,100% 0,100% 100%,0 100%);border-radius:4px;z-index:2}
.env .front::after{content:"";position:absolute;inset:0;background:linear-gradient(160deg,rgba(255,255,255,.12),transparent 50%)}
.env .flap{position:absolute;left:0;right:0;top:0;height:58%;background:#7F9575;clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top;transition:transform .7s ease;z-index:3;backface-visibility:hidden}
.env .seal{position:absolute;left:50%;top:56%;transform:translate(-50%,-50%);width:70px;height:70px;z-index:4;transition:transform .5s ease,opacity .4s ease}
.env.open .flap{transform:rotateX(180deg);z-index:1}
.env.open .seal{transform:translate(-50%,-50%) scale(1.3);opacity:0}
.env.open .letter{transform:translateY(-58%)}
.intro .hint{font-family:var(--f-caps);font-size:.7rem;letter-spacing:.26em;text-transform:uppercase;color:var(--sage-deep);margin:0;animation:breathe 2.4s ease-in-out infinite}
.intro .hint span{display:block;font-family:var(--f-bn);letter-spacing:.04em;text-transform:none;font-size:.95rem;color:var(--muted);margin-top:4px}
@keyframes breathe{50%{opacity:.45}}

/* Floating UI */
.fixed-ui{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:20;display:flex;gap:10px}
.fixed-ui.right{right:calc(16px + env(safe-area-inset-right,0px))}
.fixed-ui.left{left:calc(16px + env(safe-area-inset-left,0px))}
.fab{width:50px;height:50px;border-radius:50%;border:1px solid var(--sage);background:var(--card);color:var(--sage-deep);cursor:pointer;display:grid;place-items:center;box-shadow:0 10px 24px -12px rgba(63,90,54,.7)}
.fab svg{width:22px;height:22px}
.fab.on{background:var(--sage-deep);color:var(--card)}
.fab.on.music{animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(111,138,99,.5)}50%{box-shadow:0 0 0 11px rgba(111,138,99,0)}}
#sky{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:5}
.bfly{position:fixed;left:0;top:0;width:34px;height:28px;z-index:7;cursor:pointer;will-change:transform;-webkit-tap-highlight-color:transparent;background:none;border:0;padding:0}
.bfly svg{width:100%;height:100%;overflow:visible}
.bfly .wl{transform-origin:17px 14px;animation:flapL .22s ease-in-out infinite alternate}
.bfly .wr{transform-origin:17px 14px;animation:flapR .22s ease-in-out infinite alternate}
.bfly.rest .wl,.bfly.rest .wr{animation-duration:1.4s}
@keyframes flapL{to{transform:scaleX(.25)}}
@keyframes flapR{to{transform:scaleX(.25)}}

footer{text-align:center;padding-block:10px 120px;position:relative;z-index:1;display:flex;flex-direction:column;gap:8px;align-items:center}
